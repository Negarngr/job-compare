_RX = {k: (c, re.compile(p, re.I)) for k, (c, p) in SKILLS.items()}


def extract_skills(text):
    return sorted(k for k, (_, rx) in _RX.items() if rx.search(text or ""))


START = re.compile(r"(شرح شغل|وظایف و مسئولیت|مسئولیت‌ها|Responsibilities|What you.?ll do|주요\s?업무)", re.I)
END = re.compile(r"(مهارت|شرایط|Requirements|Qualifications|자격\s?요건)", re.I)


def extract_responsibilities(text):
    text = text or ""
    m = START.search(text)
    if not m:
        return []
    rest = text[m.end():]
    e = END.search(rest)
    block = rest[:e.start()] if e else rest[:2000]
    lines = [l.strip(" -•*\t") for l in block.splitlines()]
    return [l for l in lines if 8 < len(l) < 300][:15]
